# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Scheme+host(:port) exactly as the browser will access the app - required
# for CSRF to work behind the Nginx proxy. Add every host you'll use.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8088
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_LANGUAGE_CODE=pt-br

# Security (set to True once served over HTTPS)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# PostgreSQL
POSTGRES_DB=soc_control
POSTGRES_USER=soc_control
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Gunicorn
GUNICORN_WORKERS=3

# E-mail (digest de revisões vencidas / gaps parados - app `notifications`)
# Backend padrão (se as linhas abaixo ficarem de fora) é o de console, que
# só imprime o e-mail no log do container - seguro para dev, não envia nada.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=soc-control@example.com
# Host:porta real pelo qual o sistema é acessado - usado para montar links
# dentro do corpo do e-mail (o comando roda fora de uma requisição HTTP).
DJANGO_SITE_URL=http://localhost:8088

# Rastreamento de erros (opcional). Vazio = desativado, sem custo nenhum.
DJANGO_SENTRY_DSN=
DJANGO_SENTRY_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Produção com domínio público próprio (docker-compose.prod.yml) - além dos
# valores acima, ajuste:
#   DJANGO_DEBUG=False
#   DJANGO_ALLOWED_HOSTS=SEU_DOMINIO_AQUI
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://SEU_DOMINIO_AQUI
#   DJANGO_SECURE_SSL_REDIRECT=True
#   DJANGO_SESSION_COOKIE_SECURE=True
#   DJANGO_CSRF_COOKIE_SECURE=True
#   DJANGO_SITE_URL=https://SEU_DOMINIO_AQUI
# E gere um DJANGO_SECRET_KEY exclusivo (nunca reaproveite o de dev):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Substitua também SEU_DOMINIO_AQUI em docker/nginx/nginx.prod.conf e no
# comando certbot do topo de docker-compose.prod.yml.
# ---------------------------------------------------------------------------
